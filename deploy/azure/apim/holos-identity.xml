<!--
  Azure API Management inbound policy for HOLOS behind APIM, with forwarded identity
  (holos-server ‑‑trust-forwarded-identity).

  APIM validates the caller's Entra ID token and turns its claims into the three headers
  HOLOS reads. It first removes whatever the client sent under those names: without that,
  any caller could send X-Holos-Roles: admin and be believed. Replace the {{tenant-id}} and
  {{holos-app-id}} named values with your tenant and the API's app registration.

  Roles come from the token's `roles` claim (app roles assigned in Entra ID); add the
  `groups` claim the same way if policy is written against groups. Clearance, if used, is
  read from an app role named `clearance-N`, highest wins.
-->
<policies>
  <inbound>
    <base />
    <!-- The client's own copies of the identity headers never reach the server. -->
    <set-header name="X-Holos-Principal" exists-action="delete" />
    <set-header name="X-Holos-Roles" exists-action="delete" />
    <set-header name="X-Holos-Clearance" exists-action="delete" />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization"
        failed-validation-httpcode="401" failed-validation-error-message="Unauthorized"
        output-token-variable-name="token">
      <audiences>
        <audience>api://{{holos-app-id}}</audience>
      </audiences>
    </validate-azure-ad-token>
    <set-header name="X-Holos-Principal" exists-action="override">
      <value>@(((Jwt)context.Variables["token"]).Claims.GetValueOrDefault("oid", ""))</value>
    </set-header>
    <set-header name="X-Holos-Roles" exists-action="override">
      <value>@(string.Join(",", ((Jwt)context.Variables["token"]).Claims.GetValueOrDefault("roles", new string[0])))</value>
    </set-header>
    <set-header name="X-Holos-Clearance" exists-action="override">
      <value>@{
        var roles = ((Jwt)context.Variables["token"]).Claims.GetValueOrDefault("roles", new string[0]);
        var levels = roles.Where(r => r.StartsWith("clearance-"))
                          .Select(r => { int n; return int.TryParse(r.Substring(10), out n) ? n : 0; });
        return levels.Any() ? levels.Max().ToString() : "0";
      }</value>
    </set-header>
    <!-- The token itself has done its job at the edge; it is not forwarded. -->
    <set-header name="Authorization" exists-action="delete" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
