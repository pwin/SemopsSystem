{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "image": { "value": "${SEMOPS_IMAGE=ghcr.io/pwin/semops:0.31.1}" },
    "mode": { "value": "${SEMOPS_MODE=replica}" },
    "snapshotFile": { "value": "${SEMOPS_SNAPSHOT_FILE=snapshots/latest.nq.gz}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID=}" }
  }
}
