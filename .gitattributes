# The engine directories keep their own .gitattributes, which apply inside them. This covers
# the root and the shared vendor/ directory, on the same terms as HOLOS's: LF in the
# repository, and LF on checkout for anything a Linux machine runs or a test compares byte
# for byte.
* text=auto eol=lf

*.ps1           text eol=crlf

*.png           binary
*.jpg           binary
*.gz            binary
*.zip           binary
*.whl           binary
*.pdf           binary

Cargo.lock      linguist-generated=true

# gist, bundled unchanged: kept byte for byte, mixed line endings included, so its checksum
# is the release's.
crates/semops-placetime/ontology/gist/*.ttl -text
